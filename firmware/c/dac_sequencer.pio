;
; Timed output sequencer for AD7543 DAC bit-bang over GPIO 19-22.
;
; Each 32-bit word from the TX FIFO encodes:
;   bits [31:28] → 4 GPIO states: Enable, Data, Clock, Strobe (MSB first)
;   bits [27:0]  → delay count (loops at SM clock rate, 1 MHz → 1 µs/count)
;
; SM clock divider set to 125 (125 MHz / 125 = 1 MHz) so delay unit = 1 µs.
; Set pins base = PIN_OUT_HV_Enable (GPIO 19), count = 4 (consecutive).
;
.program dac_sequencer

.wrap_target
    pull block          ; stall until next word arrives from DMA/CPU
    out pins, 4         ; top 4 bits → Enable, Data, Clock, Strobe
    out x, 28           ; lower 28 bits → delay count
delay:
    jmp x-- delay       ; busy-wait delay (1 µs per iteration at 1 MHz)
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void dac_sequencer_program_init(PIO pio, uint sm, uint offset, uint pin_base) {
    pio_sm_config c = dac_sequencer_program_get_default_config(offset);
    sm_config_set_out_pins(&c, pin_base, 4);
    // 1 MHz SM clock: 125 MHz / 125 = 1 MHz
    sm_config_set_clkdiv(&c, 125.0f);
    // shift out from MSB, auto-pull disabled (we pull explicitly)
    sm_config_set_out_shift(&c, false, false, 32);

    for (uint i = 0; i < 4; i++) {
        pio_gpio_init(pio, pin_base + i);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, pin_base, 4, true);  // outputs
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
