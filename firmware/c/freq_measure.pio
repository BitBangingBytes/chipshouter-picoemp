;
; Measures the full period (rising edge to rising edge) of a PWM signal.
;
; Counts through both HIGH and LOW phases using equal 3-cycle loops, so no
; duty cycle assumption is required. Each loop iteration = 3 system clock
; cycles (24 ns at 125 MHz).
;
; The pushed value is 0xFFFFFFFF - N, where N = total loop iterations.
;
; Conversion:
;   period_cycles = 3 * N = 3 * (0xFFFFFFFF - pushed)
;   period_ns     = 24 * N  (3 cycles * 8 ns/cycle)
;   frequency_hz  = 1_000_000_000 / period_ns
;
; Uses push noblock so FIFO overflow silently discards; CPU drains in main loop.
;
.program freq_measure

.wrap_target
    wait 0 pin 0        ; sync: ensure pin is LOW
    wait 1 pin 0        ; rising edge #1 — start of period
    mov x, ~null        ; x = 0xFFFFFFFF (counts down)

high:
    jmp x-- high_chk    ; 1 cycle
high_chk:
    jmp pin high_nop    ; 1 cycle: still HIGH → high_nop (3 cycles/iter)
    jmp low             ; 1 cycle: pin went LOW → enter low phase
high_nop:
    jmp high            ; 1 cycle (pad to equalise with low loop)

low:
    jmp x-- low_chk     ; 1 cycle
low_chk:
    jmp pin done        ; 1 cycle: rising edge #2 → done (3 cycles/iter)
    jmp low             ; 1 cycle: still LOW → loop

done:
    mov isr, x
    push noblock        ; push to RX FIFO; discard + clear ISR if full
.wrap

% c-sdk {
static inline void freq_measure_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = freq_measure_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin);    // base for 'wait pin' instructions
    sm_config_set_jmp_pin(&c, pin);    // pin for 'jmp pin' instruction
    pio_gpio_init(pio, pin);           // assign GPIO to this PIO instance
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);  // input
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
